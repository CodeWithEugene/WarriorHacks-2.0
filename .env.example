# Copy to .env.local (never commit real values). `pnpm dlx vercel env pull .env.local` fills most of these.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Contact shown in the National Weather Service User-Agent (a URL or email you control)
APP_CONTACT=https://github.com/CodeWithEugene/WarriorHacks-2.0

# Database (Neon Postgres via the Vercel Marketplace)
DATABASE_URL=postgres://user:password@host/db
DATABASE_URL_UNPOOLED=postgres://user:password@host/db

# TypeSafe Jev: every semantic judgment (check-in triage, Ask Flagline, meter value selection). Server-only.
TYPESAFE_API_KEY=

# OpenRouter: reads digits from meter photos (vision transcription only). Server-only.
OPENROUTER_API_KEY=
# Optional override. Must accept images. Default: moonshotai/kimi-k3 (4/4 on pnpm eval:meter).
OPENROUTER_VISION_MODEL=

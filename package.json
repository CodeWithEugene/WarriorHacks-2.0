{
  "name": "flagline",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "vitest run tests/conformance",
    "fixtures:thermofeel": "python3 scripts/fixtures/thermofeel_reference.py",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "eval:triage": "tsx --tsconfig tsconfig.json scripts/evals/triage-eval.ts",
    "eval:ask": "tsx --tsconfig tsconfig.json scripts/evals/ask-eval.ts",
    "db:seed": "tsx --tsconfig tsconfig.json scripts/db/seed-demo.ts",
    "db:clear-test": "tsx --tsconfig tsconfig.json scripts/db/clear-test-data.ts",
    "eval:meter": "tsx --tsconfig tsconfig.json scripts/evals/meter-eval.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^5.9.1",
    "@neondatabase/serverless": "^1.1.0",
    "@shadcn/react": "^0.3.1",
    "@typesafe-ai/sdk": "^0.6.0",
    "chrono-node": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.4",
    "next-intl": "^4.14.7",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.2",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@11.21.0"
}
